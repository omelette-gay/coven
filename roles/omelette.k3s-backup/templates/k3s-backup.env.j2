# {{ ansible_managed }}
# Configuration shared by the k3s-datastore-* scripts.
K3S_BACKUP_DB_PATH={{ k3s_backup_db_path }}
K3S_BACKUP_REMOTE=:gcs:{{ gcp_backup_bucket_name }}/{{ k3s_backup_gcs_prefix }}
K3S_BACKUP_INTERVAL_SECONDS={{ k3s_backup_interval_hours * 3600 }}

# rclone reads these as defaults for the on-the-fly :gcs: remote above, so no rclone config file is needed (and
# pointing it at /dev/null stops it logging that it couldn't find one)
RCLONE_CONFIG=/dev/null
RCLONE_GCS_SERVICE_ACCOUNT_FILE={{ k3s_backup_gcp_key_path }}
# the bucket uses uniform bucket-level access, so rclone mustn't try to set per-object ACLs
RCLONE_GCS_BUCKET_POLICY_ONLY=true
# the service account only has objectAdmin on the bucket, so can't check whether the bucket itself exists
RCLONE_GCS_NO_CHECK_BUCKET=true
