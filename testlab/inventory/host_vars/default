---
ansible_ssh_host: 192.168.57.100
ansible_ssh_user: vagrant
ansible_ssh_private_key_file: "{{ '.vagrant/machines/default/*/private_key' | fileglob | first }}"

hostname: vagrant.local

k3s_agent:
  node-name: "{{ hostname }}"
  node-ip: 192.168.57.100

  node-label:
    # As on strix, so Traefik's nodeSelector matches (see tfmodules/stack-bootstrap/traefik.tf)
    - svccontroller.k3s.cattle.io/enablelb=true
