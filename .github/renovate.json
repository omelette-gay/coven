{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)tasks/.*\\.ya?ml$/",
        "/(^|/)roles/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "repository:\\s*[\"']?(?<depName>[^\\s\"']+)[\"']?\\s*\\n(?:\\s*#.*\\n)?\\s*tag:\\s*[\"']?(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+[^\"'\\s]*)[\"']?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?)\\s+depName=(?<depName>.*?)\\n.*_version:\\s*\"(?<currentValue>.*?)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.tf$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\n\\s*\\w+\\s*=\\s*\"(?<currentValue>[^\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\""
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["pep621", "terraform"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "matchDatasources": ["helm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": ">=1.0.0",
      "matchPackageNames": [
        "!cert-manager",
        "!external-dns",
        "!longhorn",
        "!mariadb-operator",
        "!mariadb-operator-crds"
      ],
      "groupName": "Helm charts (non-major)",
      "schedule": ["before 6am on monday"]
    },
    {
      "matchDatasources": ["helm"],
      "matchPackageNames": ["mariadb-operator", "mariadb-operator-crds"],
      "groupName": "mariadb-operator"
    },
    {
      "description": "factoriotools/factorio also tags experimental releases with plain version numbers, so only follow the stable-x.y.z tags",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["factoriotools/factorio"],
      "versioning": "regex:^stable-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "ignoreDeps": ["planka"]
}
