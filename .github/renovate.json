{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":preserveSemverRanges"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)tasks/.*\\.ya?ml$/",
        "/(^|/)roles/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "repository:\\s*[\"']?(?<depName>[^\\s\"']+)[\"']?\\s*\\n(?:\\s*#.*\\n)?\\s*tag:\\s*[\"']?(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+[^\"'\\s]*)[\"']?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?)\\s+depName=(?<depName>.*?)\\n.*_version:\\s*\"(?<currentValue>.*?)\""
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.tf$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\n\\s*\\w+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "factoriotools/factorio also tags experimental releases with plain version numbers, so only follow the stable-x.y.z tags",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["factoriotools/factorio"],
      "versioning": "regex:^stable-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ]
}
