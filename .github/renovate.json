{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.tf$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\n\\s*\\w+\\s*=\\s*\"(?<currentValue>[^\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\""
      ]
    },
    {
      "customType": "regex",
      "description": "Images run with docker run in workflows, e.g. the linters in lint.yml, pinned as image:version@digest",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<depName>rhysd/actionlint|ghcr\\.io/zizmorcore/zizmor):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "pep621",
        "terraform"
      ],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Platform: minor and patch updates to Helm charts at 1.0.0 or above, except charts whose minor releases are significant (see ADR 004)",
      "matchDatasources": [
        "helm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": ">=1.0.0",
      "matchPackageNames": [
        "!cert-manager",
        "!external-dns",
        "!longhorn",
        "!mariadb-operator",
        "!mariadb-operator-crds"
      ],
      "groupName": "Platform (non-major)",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "Platform: patch updates to every Helm chart, including 0.x charts and the exclusions above",
      "matchDatasources": [
        "helm"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Platform (non-major)",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "Platform: rustfs/rc is only the client used by setup jobs, so its 0.x minor releases are grouped too",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "rustfs/rc"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Platform (non-major)",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "Platform: the Hetzner webhook is 0.x and manages DNS records, so only its patch releases are grouped",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/hetzner/external-dns-hetzner-webhook"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Platform (non-major)",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "mariadb-operator",
        "mariadb-operator-crds"
      ],
      "groupName": "mariadb-operator"
    },
    {
      "description": "The Prometheus Operator's CRDs must never be older than kube-prometheus-stack, and both take a major release when the operator's minor version changes, so their major updates come in one pull request. Minor and patch updates go in the weekly Platform bundle together",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "kube-prometheus-stack",
        "prometheus-operator-crds"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "kube-prometheus-stack (major)"
    },
    {
      "description": "Apps: charts and images for the apps this repo deploys (not the self-deploying ones). Add each new app's charts and images here, following ADR 004. Patch and digest updates are always grouped. The Factorio image isn't listed, as it needs a pull request as soon as it's released",
      "matchPackageNames": [
        "itzg/minecraft-server",
        "itzg/mc-backup",
        "minecraft",
        "ghcr.io/lunamultiplayer/lunamultiplayer/server",
        "luna-multiplayer",
        "factorio-server-charts"
      ],
      "groupName": "Apps (non-major)",
      "schedule": [
        "before 6am on monday"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest"
      ]
    },
    {
      "description": "Apps: minor updates are only grouped at 1.0.0 or above, as 0.x minor releases can break things",
      "matchPackageNames": [
        "itzg/minecraft-server",
        "itzg/mc-backup",
        "minecraft",
        "ghcr.io/lunamultiplayer/lunamultiplayer/server",
        "luna-multiplayer",
        "factorio-server-charts"
      ],
      "groupName": "Apps (non-major)",
      "schedule": [
        "before 6am on monday"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": ">=1.0.0"
    },
    {
      "description": "Tooling: Python packages (lock file only) and Galaxy collections used by Ansible. xanmanning.k3s installs k3s on the nodes, so it gets its own pull request",
      "matchManagers": [
        "pep621",
        "ansible-galaxy"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "!xanmanning.k3s"
      ],
      "groupName": "Tooling (non-major)",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "Tooling: in-range Terraform provider updates only change the lock files, and the plan on the pull request shows their effect",
      "matchDatasources": [
        "terraform-provider"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Tooling (non-major)",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "Tooling: Terraform CLI patch releases",
      "matchManagers": [
        "terraform-version"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Tooling (non-major)",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "Tooling: GitHub Actions and the Helm CLI version used in CI. Actions are pinned to commit SHAs, so digest updates (e.g. when a tag like v1 moves) and pinning any newly added action are bundled too",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "Tooling (non-major)",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "Tooling: the linters lint.yml runs as images. gitleaks, in the terraform-plan action, is pinned by checksum, which Renovate can't update, so it's updated by hand",
      "matchPackageNames": [
        "rhysd/actionlint",
        "ghcr.io/zizmorcore/zizmor"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "Tooling (non-major)",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "description": "factoriotools/factorio also tags experimental releases with plain version numbers, so only follow the stable-x.y.z tags. Factorio clients update themselves and the server version has to match, so raise a pull request as soon as a release is out, with no minimum release age",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "factoriotools/factorio"
      ],
      "versioning": "regex:^stable-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "minimumReleaseAge": "0 days"
    }
  ]
}
