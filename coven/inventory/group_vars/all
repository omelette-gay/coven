k8s_github_deployment_roles:
  - github_repo: cnorthwood/chriss-weight-tracker
    k8s_namespace: weight-tracker
    role_name: weight-tracker
    vault_secrets:
      - vault_secret_name: weight-tracker/google-oauth
        k8s_secret_name: google-oauth
        k8s_namespace: weight-tracker
        k8s_service_account_name: weight-tracker-google-oauth-secret
        vault_role_name: weight-tracker-secrets
      - vault_secret_name: weight-tracker/google-service-account
        k8s_secret_name: google-service-account
        k8s_namespace: weight-tracker
        k8s_service_account_name: weight-tracker
        vault_role_name: weight-tracker-google-secret

  - github_repo: omelette-gay/wedding
    k8s_namespace: wedding
    role_name: wedding
    ghcr_credentials_secret: ghcr-credentials
    vault_secrets:
      - vault_secret_name: wedding/app
        k8s_secret_name: wedding-app-secrets
        k8s_namespace: wedding
        k8s_service_account_name: wedding-app-secrets
        vault_role_name: wedding-app-secrets
      - vault_secret_name: backups/service-account-key
        k8s_secret_name: wedding-gcp-backup-creds
        k8s_namespace: wedding
        k8s_service_account_name: wedding-gcp-backup-creds
        vault_role_name: wedding-gcp-backup-creds
    keycloak_client_id: wedding
    keycloak_redirect_uris:
      - https://wedding.omelette.gay/oidc/callback/
    keycloak_k8s_secret: wedding-sso-secrets

  - github_repo: cnorthwood/virtualflightonlinetransmitter
    k8s_namespace: virtualflightonlinetransmitter
    role_name: virtualflightonlinetransmitter
    vault_secrets:
      - vault_secret_name: virtualflightonlinetransmitter/app
        k8s_secret_name: server-secret
        k8s_namespace: virtualflightonlinetransmitter
        k8s_service_account_name: virtualflightonlinetransmitter-secrets
        vault_role_name: virtualflightonlinetransmitter-secrets

  - github_repo: cnorthwood/manchestertechnights.org
    k8s_namespace: manchestertechnights
    role_name: manchestertechnights
    ghcr_credentials_secret: ghcr-credentials
    vault_secrets:
      - vault_secret_name: manchestertechnights/app
        k8s_secret_name: app-secret
        k8s_namespace: manchestertechnights
        k8s_service_account_name: manchestertechnights-secrets
        vault_role_name: manchestertechnights-secrets

  - github_repo: cnorthwood/chrisn.xyz
    k8s_namespace: chrisn-xyz
    role_name: chrisn-xyz
    vault_secrets:
      - vault_secret_name: chrisn-xyz/wordpress
        k8s_secret_name: wordpress
        k8s_namespace: chrisn-xyz
        k8s_service_account_name: chrisn-xyz-wordpress-secrets
        vault_role_name: chrisn-xyz-wordpress-secrets
      - vault_secret_name: backups/service-account-creds
        k8s_secret_name: gcp-backups
        k8s_namespace: chrisn-xyz
        k8s_service_account_name: chrisn-xyz-gcp-backups
        vault_role_name: chrisn-xyz-gcp-backups

  - github_repo: omelette-gay/home-assistant
    k8s_namespace: home-assistant
    role_name: home-assistant
    ghcr_credentials_secret: ghcr-credentials
    keycloak_client_id: home-assistant
    keycloak_redirect_uris:
      - https://home.gs.omelette.gay/auth/oidc/callback
    keycloak_client_roles:
      - admin
      - resident
    keycloak_k8s_secret: home-assistant-sso-secrets

planka_hostname: boards.omelette.gay

# increase storage for logs in prod
loki_storage_size: 50Gi

wireguard_server_public_key: "{% if not bootstrap|default(false) %}{{ lookup('hashivault', 'wireguard/janus', 'public_key', mount_point=vault_kv_mountpoint, version=2, url=vault_url, verify=kubeconfig_require_secure|default(true)) }}{% else %}{{ omit }}{% endif %}"
wireguard_server_preshared_key: "{% if not bootstrap|default(false) %}{{ lookup('hashivault', 'wireguard/janus', 'preshared_key', mount_point=vault_kv_mountpoint, version=2, url=vault_url, verify=kubeconfig_require_secure|default(true)) }}{% else %}{{ omit }}{% endif %}"
wireguard_ipv4_network: 192.168.178.0/24
wireguard_ipv6_network: fd1e:6349:c40a::/64
wireguard_server_endpoint: janus.gs.omelette.gay:59384

outbound_mail_node_selector:
  "coven.omelette.gay/location": "xdc"
